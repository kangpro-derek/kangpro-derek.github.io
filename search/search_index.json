{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"]},"docs":[{"location":"","title":"Welcome KangPro","text":"<p>\uac15\ud504\ub85c \uc0ac\uc774\ud2b8\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\uc18c\uac1c","text":"<ul> <li>\ud000\ud2b8 \ud22c\uc790\ub97c \ub3c4\uc640\uc8fc\ub294 \uc5ec\ub7ec\uac00\uc9c0 \ud234\uc744 \uac1c\ubc1c\ud569\ub2c8\ub2e4.</li> </ul>"},{"location":"#_2","title":"\ud504\ub85c\uc81d\ud2b8 \ubaa9\ub85d","text":"<ul> <li>\ub5a8\uc0ac\uc624\ud314Pro\ub808\uc774\ub354 \ubc14\ub85c\uac00\uae30 - \ub5a8\uc0ac\uc624\ud314\uc744 \ubcf4\ub2e4 \ub354 \uac15\ub825\ud558\uac8c \ub3c4\uc640\uc8fc\ub294 \ud234</li> <li>\uace0\ubd80\uae30Pro \ubb38\uc11c \ubc14\ub85c\uac00\uae30 - \ud130\ud2c0\ud2b8\ub808\uc774\ub529 \uc804\ub7b5\uc744 \ube44\ud2b8\ucf54\uc778\uc73c\ub85c \uc790\ub3d9\ub9e4\ub9e4 \ubd07</li> </ul>"}]}